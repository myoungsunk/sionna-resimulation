+def match_partial(ref_tau, ref_dirs, tau, dirs, tol: float = 1e-4, tau_tol: float = 2e-13):
+    """Rectangular version of ``align_paths``: ``(match, extra)`` with ``match[i]`` = index into the new trace for reference path ``i`` (-1 if the
